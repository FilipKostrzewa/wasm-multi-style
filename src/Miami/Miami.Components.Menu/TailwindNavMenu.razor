@* Modern Tailwind CSS Navigation Menu *@

<nav class="bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 shadow-xl">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
            <!-- Logo and Brand -->
            <div class="flex items-center">
                <a href="" class="flex items-center space-x-2 text-white hover:text-gray-200 transition-colors duration-200">
                    <svg class="h-8 w-8" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 2L2 7v10c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-10-5z"/>
                    </svg>
                    <span class="text-xl font-bold">Miami.App</span>
                </a>
            </div>

            <!-- Desktop Navigation -->
            <div class="hidden md:block">
                <div class="ml-10 flex items-baseline space-x-1">
                    <NavLink href="" Match="NavLinkMatch.All" 
                             class="@GetNavLinkClass()" 
                             ActiveClass="bg-white/20 backdrop-blur-sm text-white">
                        <span class="flex items-center space-x-2 px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200">
                            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                            </svg>
                            <span>Home</span>
                        </span>
                    </NavLink>

                    <NavLink href="page-one" 
                             class="@GetNavLinkClass()" 
                             ActiveClass="bg-white/20 backdrop-blur-sm text-white">
                        <span class="flex items-center space-x-2 px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200">
                            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/>
                            </svg>
                            <span>Tailwind</span>
                        </span>
                    </NavLink>

                    <NavLink href="page-two" 
                             class="@GetNavLinkClass()" 
                             ActiveClass="bg-white/20 backdrop-blur-sm text-white">
                        <span class="flex items-center space-x-2 px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200">
                            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                            </svg>
                            <span>Page Two</span>
                        </span>
                    </NavLink>

                    <NavLink href="page-three" 
                             class="@GetNavLinkClass()" 
                             ActiveClass="bg-white/20 backdrop-blur-sm text-white">
                        <span class="flex items-center space-x-2 px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200">
                            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                            </svg>
                            <span>Page Three</span>
                        </span>
                    </NavLink>

                    <NavLink href="counter" 
                             class="@GetNavLinkClass()" 
                             ActiveClass="bg-white/20 backdrop-blur-sm text-white">
                        <span class="flex items-center space-x-2 px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200">
                            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v3m0 0v3m0-3h3m-3 0H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                            <span>Counter</span>
                        </span>
                    </NavLink>

                    <NavLink href="weather" 
                             class="@GetNavLinkClass()" 
                             ActiveClass="bg-white/20 backdrop-blur-sm text-white">
                        <span class="flex items-center space-x-2 px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200">
                            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/>
                            </svg>
                            <span>Weather</span>
                        </span>
                    </NavLink>

                    <NavLink href="chatbot" 
                             class="@GetNavLinkClass()" 
                             ActiveClass="bg-white/20 backdrop-blur-sm text-white">
                        <span class="flex items-center space-x-2 px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200">
                            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>
                            </svg>
                            <span>Chatbot</span>
                        </span>
                    </NavLink>
                </div>
            </div>

            <!-- Mobile menu button -->
            <div class="md:hidden">
                <button @onclick="ToggleMobileMenu" 
                        type="button" 
                        class="inline-flex items-center justify-center p-2 rounded-lg text-white hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-white transition-all duration-200">
                    <span class="sr-only">Open main menu</span>
                    @if (!isMobileMenuOpen)
                    {
                        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                        </svg>
                    }
                    else
                    {
                        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                        </svg>
                    }
                </button>
            </div>
        </div>
    </div>

    <!-- Mobile menu -->
    @if (isMobileMenuOpen)
    {
        <div class="md:hidden bg-gradient-to-b from-purple-700 to-pink-700 border-t border-white/10">
            <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3">
                <NavLink href="" Match="NavLinkMatch.All" 
                         class="@GetMobileNavLinkClass()" 
                         ActiveClass="bg-white/20 text-white">
                    <span class="flex items-center space-x-3 px-3 py-3 rounded-lg text-base font-medium transition-all duration-200" @onclick="CloseMobileMenu">
                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                        </svg>
                        <span>Home</span>
                    </span>
                </NavLink>

                <NavLink href="page-one" 
                         class="@GetMobileNavLinkClass()" 
                         ActiveClass="bg-white/20 text-white">
                    <span class="flex items-center space-x-3 px-3 py-3 rounded-lg text-base font-medium transition-all duration-200" @onclick="CloseMobileMenu">
                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/>
                        </svg>
                        <span>Tailwind</span>
                    </span>
                </NavLink>

                <NavLink href="page-two" 
                         class="@GetMobileNavLinkClass()" 
                         ActiveClass="bg-white/20 text-white">
                    <span class="flex items-center space-x-3 px-3 py-3 rounded-lg text-base font-medium transition-all duration-200" @onclick="CloseMobileMenu">
                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                        </svg>
                        <span>Page Two</span>
                    </span>
                </NavLink>

                <NavLink href="page-three" 
                         class="@GetMobileNavLinkClass()" 
                         ActiveClass="bg-white/20 text-white">
                    <span class="flex items-center space-x-3 px-3 py-3 rounded-lg text-base font-medium transition-all duration-200" @onclick="CloseMobileMenu">
                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                        </svg>
                        <span>Page Three</span>
                    </span>
                </NavLink>

                <NavLink href="counter" 
                         class="@GetMobileNavLinkClass()" 
                         ActiveClass="bg-white/20 text-white">
                    <span class="flex items-center space-x-3 px-3 py-3 rounded-lg text-base font-medium transition-all duration-200" @onclick="CloseMobileMenu">
                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v3m0 0v3m0-3h3m-3 0H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        <span>Counter</span>
                    </span>
                </NavLink>

                <NavLink href="weather" 
                         class="@GetMobileNavLinkClass()" 
                         ActiveClass="bg-white/20 text-white">
                    <span class="flex items-center space-x-3 px-3 py-3 rounded-lg text-base font-medium transition-all duration-200" @onclick="CloseMobileMenu">
                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/>
                        </svg>
                        <span>Weather</span>
                    </span>
                </NavLink>

                <NavLink href="chatbot" 
                         class="@GetMobileNavLinkClass()" 
                         ActiveClass="bg-white/20 text-white">
                    <span class="flex items-center space-x-3 px-3 py-3 rounded-lg text-base font-medium transition-all duration-200" @onclick="CloseMobileMenu">
                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>
                        </svg>
                        <span>Chatbot</span>
                    </span>
                </NavLink>
            </div>
        </div>
    }
</nav>

@code {
    private bool isMobileMenuOpen = false;

    private void ToggleMobileMenu()
    {
        isMobileMenuOpen = !isMobileMenuOpen;
    }

    private void CloseMobileMenu()
    {
        isMobileMenuOpen = false;
    }

    private string GetNavLinkClass()
    {
        return "text-white/90 hover:bg-white/10 hover:text-white";
    }

    private string GetMobileNavLinkClass()
    {
        return "text-white/90 hover:bg-white/10 hover:text-white block";
    }
}
