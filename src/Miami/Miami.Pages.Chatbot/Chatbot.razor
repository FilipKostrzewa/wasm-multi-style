@page "/chatbot"

<PageTitle>Chatbot</PageTitle>

<div class="min-h-screen bg-gradient-to-br from-blue-50 to-purple-100">
    <!-- Header -->
    <header class="bg-white shadow-lg">
        <div class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
            <h1 class="text-4xl font-bold text-gray-900">Simple Chatbot</h1>
            <p class="mt-2 text-lg text-gray-600">Chat with our friendly bot (random responses)</p>
        </div>
    </header>

    <main class="max-w-4xl mx-auto py-6 sm:px-6 lg:px-8">
        <div class="px-4 py-6 sm:px-0">
            <!-- Chat Container -->
            <div class="bg-white rounded-lg shadow-xl overflow-hidden">
                <!-- Chat Messages -->
                <div class="h-96 overflow-y-auto p-6 space-y-4 bg-gray-50" @ref="chatContainer">
                    @foreach (var message in messages)
                    {
                        @if (message.IsUser)
                        {
                            <!-- User Message -->
                            <div class="flex justify-end">
                                <div class="bg-blue-500 text-white rounded-lg py-2 px-4 max-w-xs lg:max-w-md">
                                    <p class="text-sm">@message.Text</p>
                                    <p class="text-xs text-blue-100 mt-1">@message.Timestamp.ToString("HH:mm")</p>
                                </div>
                            </div>
                        }
                        else
                        {
                            <!-- Bot Message -->
                            <div class="flex justify-start">
                                <div class="bg-gray-200 text-gray-800 rounded-lg py-2 px-4 max-w-xs lg:max-w-md">
                                    <p class="text-sm">@message.Text</p>
                                    <p class="text-xs text-gray-500 mt-1">@message.Timestamp.ToString("HH:mm")</p>
                                </div>
                            </div>
                        }
                    }
                    
                    @if (isTyping)
                    {
                        <!-- Typing Indicator -->
                        <div class="flex justify-start">
                            <div class="bg-gray-200 text-gray-800 rounded-lg py-3 px-4">
                                <div class="flex space-x-2">
                                    <div class="w-2 h-2 bg-gray-500 rounded-full animate-bounce"></div>
                                    <div class="w-2 h-2 bg-gray-500 rounded-full animate-bounce" style="animation-delay: 0.2s"></div>
                                    <div class="w-2 h-2 bg-gray-500 rounded-full animate-bounce" style="animation-delay: 0.4s"></div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Chat Input -->
                <div class="bg-white border-t border-gray-200 p-4">
                    <form @onsubmit="SendMessage" class="flex space-x-2">
                        <input 
                            @bind="userInput" 
                            @bind:event="oninput"
                            type="text" 
                            placeholder="Type your message..."
                            class="flex-1 border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                            disabled="@isTyping" />
                        <button 
                            type="submit" 
                            class="bg-blue-500 hover:bg-blue-600 text-white font-semibold px-6 py-2 rounded-lg transition-colors duration-200 disabled:bg-gray-300 disabled:cursor-not-allowed"
                            disabled="@(string.IsNullOrWhiteSpace(userInput) || isTyping)">
                            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                            </svg>
                        </button>
                    </form>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="mt-6">
                <h3 class="text-sm font-semibold text-gray-700 mb-3">Quick Messages:</h3>
                <div class="flex flex-wrap gap-2">
                    <button @onclick='() => SendQuickMessage("Hello!")' class="bg-white hover:bg-gray-50 text-gray-700 text-sm px-4 py-2 rounded-lg border border-gray-300 transition-colors duration-200">
                        ?? Hello!
                    </button>
                    <button @onclick='() => SendQuickMessage("How are you?")' class="bg-white hover:bg-gray-50 text-gray-700 text-sm px-4 py-2 rounded-lg border border-gray-300 transition-colors duration-200">
                        ?? How are you?
                    </button>
                    <button @onclick='() => SendQuickMessage("Tell me a joke")' class="bg-white hover:bg-gray-50 text-gray-700 text-sm px-4 py-2 rounded-lg border border-gray-300 transition-colors duration-200">
                        ?? Tell me a joke
                    </button>
                    <button @onclick='() => SendQuickMessage("What can you do?")' class="bg-white hover:bg-gray-50 text-gray-700 text-sm px-4 py-2 rounded-lg border border-gray-300 transition-colors duration-200">
                        ? What can you do?
                    </button>
                    <button @onclick="ClearChat" class="bg-red-100 hover:bg-red-200 text-red-700 text-sm px-4 py-2 rounded-lg border border-red-300 transition-colors duration-200">
                        ??? Clear Chat
                    </button>
                </div>
            </div>

            <!-- Info Panel -->
            <div class="mt-6 bg-blue-50 border-l-4 border-blue-500 text-blue-700 p-4 rounded">
                <p class="font-bold">About this chatbot</p>
                <p class="text-sm mt-1">This is a simple demonstration chatbot that responds with random pre-defined messages. No AI is involved - just pure random fun!</p>
            </div>
        </div>
    </main>
</div>
